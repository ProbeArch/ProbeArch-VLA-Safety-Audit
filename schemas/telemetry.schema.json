{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "probearch://schemas/telemetry-v1",
  "title": "ProbeArch episode telemetry",
  "type": "object",
  "required": ["harness_schema_version", "task", "task_id", "ep_ix", "success", "steps", "provenance"],
  "properties": {
    "harness_schema_version": {"const": "probearch-telemetry-v0.4"},
    "task": {"type": "string"},
    "task_id": {"type": "integer", "minimum": 0},
    "ep_ix": {"type": "integer", "minimum": 0},
    "success": {"type": "boolean"},
    "steps": {"type": "array"},
    "provenance": {"type": "object", "required": ["suite", "run_id", "policy_sha256"]}
  }
}
